# ==========================================
# AbeHotel Production Environment Variables
# ==========================================
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control!

# ==========================================
# Database Configuration
# ==========================================

# Option 1: PostgreSQL (Recommended for Production)
# Get these values from cPanel → PostgreSQL Databases
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# Option 2: SQLite (Simpler, good for small deployments)
# Uncomment this if using SQLite instead of PostgreSQL
# SQLITE_PATH="data/abehotel.sqlite"

# ==========================================
# Application Settings
# ==========================================

# Server port (cPanel usually sets this automatically)
PORT=3000

# Node environment (production for live site)
NODE_ENV=production

# Frontend URL (your actual domain)
FRONTEND_URL="https://abehotel.com"

# ==========================================
# Authentication
# ==========================================

# JWT Secret - CHANGE THIS TO A STRING RANDOM VALUE!
# Generate one at: https://generate-secret.vercel.app/64
JWT_SECRET="change-this-to-a-random-secure-string-minimum-32-chars"

# ==========================================
# Prisma Configuration
# ==========================================

# Prisma client engine (binary works better on shared hosting)
PRISMA_CLIENT_ENGINE_TYPE=binary

# ==========================================
# Optional: Email Configuration
# ==========================================

# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=your-email@domain.com
# SMTP_PASS=your-email-password

# ==========================================
# Optional: File Upload Settings
# ==========================================

# MAX_UPLOAD_SIZE=5242880
# UPLOAD_DIR=uploads

# ==========================================
# Notes for cPanel Deployment
# ==========================================
# 1. Add these variables in cPanel → Setup Node.js App → Environment Variables
# 2. Or keep them in .env file (make sure .env is NOT in .gitignore for manual uploads)
# 3. For PostgreSQL, replace username, password, and database_name with actual values
# 4. Generate a new JWT_SECRET for production - never use the default!
# 5. Set NODE_ENV=production for better performance
